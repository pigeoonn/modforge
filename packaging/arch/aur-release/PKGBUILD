# Maintainer: pigeoonn
# modforge: builds the tagged release of the public repository.
# Submit it with:  git clone ssh://aur@aur.archlinux.org/modforge.git  (then copy this file in, run makepkg --printsrcinfo > .SRCINFO)
pkgname=modforge
pkgver=6.0.0
pkgrel=1
pkgdesc='Universal Game & Mod Studio for Linux, Steam Deck & PC'
arch=('x86_64')
url='https://github.com/pigeoonn/modforge'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'curl' 'xdg-utils' 'libarchive' 'wayland' 'libxkbcommon' 'python' 'python-pyqt6' 'python-requests')
makedepends=('cargo')
optdepends=(
  'p7zip: install .7z and .rar mods'
  'unzip: fallback archive extraction'
  'gamemode: run games with gamemoderun'
  'mangohud: performance overlay'
  'libnotify: desktop notifications (notify-send)'
  'steam: sync launch options for Steam games'
)
conflicts=('modforge-git' 'gantry')
provides=('gantry')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/modforge "$pkgdir/usr/bin/modforge-engine"
  ln -sf /usr/bin/modforge-engine "$pkgdir/usr/bin/rig"
  install -Dm755 modforge_app.py "$pkgdir/usr/share/modforge/modforge_app.py"
  install -Dm755 modforge "$pkgdir/usr/bin/modforge"
  install -Dm644 packaging/modforge.desktop "$pkgdir/usr/share/applications/modforge.desktop"
  install -Dm644 src/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/modforge.png"
  install -Dm644 src/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/modforge.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
